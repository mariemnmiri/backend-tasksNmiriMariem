MONGO_URI=mongodb://127.0.0.1:27017/nutritionDB
# Google OAuth2 Credentials
# Get these from: https://console.cloud.google.com/
# 1. Create a project → Enable Google Calendar API
# 2. OAuth 2.0 Credentials → Web Application
# 3. Add http://localhost:5000/api/google/callback to Authorized redirect URIs

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# Admin secret key — used when registering a nutritionist account
# Change this to something secure!
ADMIN_SECRET=nutricoach2024

# Server port
PORT=5000